<main class="flex-1 px-3 py-6">
  <div class="mx-auto max-w-7xl">
    <%# Only messages meant for display; Doorkeeper also passes the client secret through flash. %>
    <% flash.to_hash.slice("notice", "alert").each do |key, message| %>
      <div class="mb-4 rounded-lg border p-4 text-sm <%= key == "notice" ? "border-green-200 bg-green-50 text-green-800" : "border-red-200 bg-red-50 text-red-800" %>" role="alert">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </div>
</main>

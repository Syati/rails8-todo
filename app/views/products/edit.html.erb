<% content_for :title, "#{@product.name_was} の編集" %>

<div class="max-w-2xl overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <div class="border-b border-gray-200 px-6 py-4">
    <h1 class="text-xl font-semibold text-gray-900">商品の編集</h1>
  </div>

  <div class="px-6 py-6">
    <%= render "form", product: @product, submit_label: "更新する", cancel_path: product_path(@product) %>
  </div>
</div>

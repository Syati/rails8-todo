<% content_for :title, "SKU の追加 | #{@product.name}" %>

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <div class="border-b border-gray-200 px-6 py-4">
    <h1 class="text-xl font-semibold text-gray-900">SKU の追加</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @product.name %> に、サイズと色の組み合わせを1つ追加します。</p>
  </div>

  <div class="max-w-2xl px-6 py-6">
    <%= render "form", product: @product, sku: @sku, submit_label: "追加する" %>
  </div>
</div>

<% content_for :title, "SKU #{@sku.code_was} の編集 | #{@product.name}" %>

<div class="max-w-2xl overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <div class="border-b border-gray-200 px-6 py-4">
    <h1 class="text-xl font-semibold text-gray-900">SKU の編集</h1>
    <p class="mt-1 text-sm text-gray-500"><%= @product.name %></p>
  </div>

  <div class="px-6 py-6">
    <%= render "form", product: @product, sku: @sku, submit_label: "更新する" %>
  </div>
</div>

<% content_for :title, "#{@admin.email_was} の編集" %>

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <div class="border-b border-gray-200 px-6 py-4">
    <h1 class="text-xl font-semibold text-gray-900">管理者の編集</h1>
    <p class="mt-1 text-sm text-gray-500">メールアドレスを変更すると、新しいアドレスに確認メールが届きます。確認されるまでは現在のアドレスでログインします。</p>
  </div>

  <div class="max-w-3xl px-6 py-6">
    <%= console_form_for [ :console, @admin ] do |f| %>
      <%= f.error_notification %>
      <%= f.input :email, input_html: { autocomplete: "off" } %>
      <% if @admin == current_admin %>
        <%= console_form_static_row Admin.human_attribute_name(:role) do %>
          <p class="text-sm text-gray-900"><%= Admin.human_attribute_name("role.#{@admin.role}") %></p>
          <p class="mt-2 text-sm text-gray-500">自分のロールは変更できません。</p>
        <% end %>
      <% else %>
        <%= f.input :role, collection: Admin.roles.keys.map { |role| [ Admin.human_attribute_name("role.#{role}"), role ] }, include_blank: false %>
      <% end %>
      <%= f.input :password, required: false, input_html: { autocomplete: "new-password" }, hint: "変更する場合のみ入力（#{Devise.password_length.min}文字以上）" %>
      <%= f.input :password_confirmation, required: false, input_html: { autocomplete: "new-password" } %>

      <%= console_form_actions do %>
        <%= f.button :submit, "更新する" %>
        <%= link_to "キャンセル", console_admin_path(@admin), class: "rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100" %>
      <% end %>
    <% end %>
  </div>
</div>

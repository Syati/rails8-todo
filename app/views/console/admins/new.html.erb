<% content_for :title, "管理者の新規作成" %>

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
  <div class="border-b border-gray-200 px-6 py-4">
    <h1 class="text-xl font-semibold text-gray-900">管理者の新規作成</h1>
    <p class="mt-1 text-sm text-gray-500">作成した管理者のロールはオペレーターになります。作成後、入力したメールアドレスに確認メールが届きます。</p>
  </div>

  <div class="max-w-3xl px-6 py-6">
    <%= console_form_for [ :console, @admin ] do |f| %>
      <%= f.error_notification %>
      <%= f.input :email, input_html: { autocomplete: "off" } %>
      <%= f.input :password, input_html: { autocomplete: "new-password" }, hint: "#{Devise.password_length.min}文字以上" %>
      <%= f.input :password_confirmation, input_html: { autocomplete: "new-password" } %>

      <%= console_form_actions do %>
        <%= f.button :submit, "作成する" %>
        <%= link_to "キャンセル", console_admins_path, class: "rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100" %>
      <% end %>
    <% end %>
  </div>
</div>

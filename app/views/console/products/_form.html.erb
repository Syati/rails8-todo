<%= console_form_for [ :console, product ] do |f| %>
  <%= f.error_notification %>
  <%= f.input :name %>
  <%= f.input :description, as: :text, input_html: { rows: 4 } %>
  <%= f.input :status, collection: Catalog::Product.statuses.keys.map { |key| [ Catalog::Product.human_attribute_name("status.#{key}"), key ] }, include_blank: false %>
  <%= f.input :tax_rate, collection: Catalog::Product.tax_rates.keys.map { |key| [ Catalog::Product.human_attribute_name("tax_rate.#{key}"), key ] }, include_blank: false, hint: "飲食料品は軽減税率 8% です。" %>

  <%= console_form_actions do %>
    <%= f.button :submit, submit_label %>
    <%= link_to "キャンセル", cancel_path, class: "rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100" %>
  <% end %>
<% end %>

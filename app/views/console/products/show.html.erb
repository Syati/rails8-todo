<% content_for :title, "#{@product.name} | 商品詳細" %>

<div class="grid gap-6">
  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 px-6 py-4">
      <h1 class="text-xl font-semibold text-gray-900">商品詳細</h1>
      <div class="flex gap-2">
        <%= link_to "編集", edit_console_product_path(@product), class: "rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" %>
        <%= button_to "削除", console_product_path(@product), method: :delete, form: { data: { turbo_confirm: "商品「#{@product.name}」と、その SKU #{@product.skus.size} 件を削除します。よろしいですか？" } }, class: "rounded-lg bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" %>
        <%= link_to "一覧へ戻る", console_products_path, class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-100" %>
      </div>
    </div>

    <dl class="divide-y divide-gray-200">
      <div class="grid gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500">ID</dt>
        <dd class="text-sm text-gray-900 sm:col-span-2"><%= @product.id %></dd>
      </div>
      <div class="grid gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500"><%= Catalog::Product.human_attribute_name(:name) %></dt>
        <dd class="text-sm text-gray-900 sm:col-span-2"><%= @product.name %></dd>
      </div>
      <div class="grid gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500"><%= Catalog::Product.human_attribute_name(:status) %></dt>
        <dd class="text-sm text-gray-900 sm:col-span-2"><%= render "console/products/status_badge", product: @product %></dd>
      </div>
      <div class="grid gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500"><%= Catalog::Product.human_attribute_name(:tax_rate) %></dt>
        <dd class="text-sm text-gray-900 sm:col-span-2"><%= Catalog::Product.human_attribute_name("tax_rate.#{@product.tax_rate}") %></dd>
      </div>
      <div class="grid gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500"><%= Catalog::Product.human_attribute_name(:description) %></dt>
        <dd class="whitespace-pre-line text-sm text-gray-900 sm:col-span-2"><%= @product.description.presence || "-" %></dd>
      </div>
      <div class="grid gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
        <dt class="text-sm font-medium text-gray-500"><%= Catalog::Product.human_attribute_name(:created_at) %></dt>
        <dd class="text-sm text-gray-900 sm:col-span-2"><%= l(@product.created_at, format: :long) %></dd>
      </div>
    </dl>
  </div>

  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm" id="skus">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 px-6 py-4">
      <h2 class="text-lg font-semibold text-gray-900">SKU（<%= @product.skus.size %> 件）</h2>
      <%= link_to "SKU を追加", new_console_product_sku_path(@product), class: "rounded-lg bg-blue-700 px-4 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" %>
    </div>

    <% if @product.skus.empty? %>
      <p class="px-6 py-8 text-center text-sm text-gray-500">SKU がまだありません。サイズや色ごとに SKU を追加すると、販売できるようになります。</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-500">
          <thead class="bg-gray-50 text-xs uppercase text-gray-700">
            <tr>
              <th scope="col" class="px-6 py-3"><%= Catalog::Sku.human_attribute_name(:code) %></th>
              <th scope="col" class="px-6 py-3"><%= Catalog::Sku.human_attribute_name(:size) %></th>
              <th scope="col" class="px-6 py-3"><%= Catalog::Sku.human_attribute_name(:color) %></th>
              <th scope="col" class="px-6 py-3 text-right">税込価格</th>
              <th scope="col" class="px-6 py-3 text-right"><%= Catalog::Sku.human_attribute_name(:stock_quantity) %></th>
              <th scope="col" class="px-6 py-3"><span class="sr-only">操作</span></th>
            </tr>
          </thead>
          <tbody>
            <% @product.skus.each do |sku| %>
              <tr class="border-b border-gray-200 bg-white hover:bg-gray-50" id="<%= dom_id(sku) %>">
                <td class="px-6 py-4 font-mono font-medium text-gray-900"><%= sku.code %></td>
                <td class="px-6 py-4"><%= sku.size || "-" %></td>
                <td class="px-6 py-4"><%= sku.color || "-" %></td>
                <td class="px-6 py-4 text-right tabular-nums"><%= yen(sku.price_yen) %></td>
                <td class="px-6 py-4 text-right tabular-nums">
                  <% if sku.stock_quantity.zero? %>
                    <span class="rounded-sm bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">在庫切れ</span>
                  <% else %>
                    <%= number_with_delimiter(sku.stock_quantity) %>
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex justify-end gap-3">
                    <%= link_to "編集", edit_console_product_sku_path(@product, sku), class: "font-medium text-blue-600 hover:underline" %>
                    <%= button_to "削除", console_product_sku_path(@product, sku), method: :delete, form: { data: { turbo_confirm: "SKU #{sku.code} を削除します。よろしいですか？" } }, class: "font-medium text-red-600 hover:underline" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
